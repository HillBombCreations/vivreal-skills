{
  "description": "Which Vivreal agent owns which task. Read by the session-routing and dispatch-guard hooks; check-definitions R13 proves every agent here exists. A route with a repo applies only in that repository and wins over a '*' route with the same keyword.",
  "routes": [
    { "task": "code in any repo except the portal", "agent": "vivreal-principal:coder", "keywords": ["fix", "implement", "build", "add", "refactor", "patch", "wire", "port"], "repo": "*", "note": "one repo per dispatch, ends in a pushed PR" },
    { "task": "portal code", "agent": "vivreal-principal:portal-coder", "keywords": ["fix", "implement", "build", "add", "refactor", "patch", "wire", "port"], "repo": "Vivreal_Portal_Mobile", "note": "say the mode: SOLO, PARALLEL, INTEGRATE, FOLLOWUP" },
    { "task": "single-repo release", "agent": "vivreal-workflow:release-engineer", "keywords": ["release", "promote", "backport", "merge"], "repo": "*", "note": "" },
    { "task": "portal plus backend change, full stack", "agent": "vivreal-workflow:delivery-orchestrator", "keywords": ["deliver"], "repo": "*", "note": "" },
    { "task": "design, plans, release runbooks", "agent": "vivreal-principal:architect", "keywords": ["design", "plan", "architect", "runbook"], "repo": "*", "note": "" },
    { "task": "diagnosis, audits, end-to-end traces, external web research", "agent": "vivreal-principal:researcher", "keywords": ["investigate", "research", "diagnose", "audit", "trace", "explain"], "repo": "*", "note": "" },
    { "task": "reviews", "agent": "vivreal-principal:reviewer", "keywords": ["review"], "repo": "*", "note": "" },
    { "task": "agent and skill definition review", "agent": "vivreal-agent-review:definition-reviewer", "keywords": ["definition", "definitions"], "repo": "*", "note": "" },
    { "task": "package publish and pin moves", "agent": "vivreal-workflow:package-publisher", "keywords": ["publish", "bump"], "repo": "*", "note": "" },
    { "task": "ledgers", "agent": "vivreal-workflow:ledger-keeper", "keywords": ["ledger"], "repo": "*", "note": "" },
    { "task": "dev docs", "agent": "vivreal-workflow:system-doc-writer", "keywords": ["document", "docs"], "repo": "*", "note": "" },
    { "task": "infrastructure changes", "agent": "vivreal-infra:infra-engineer", "keywords": ["provision", "iam", "cloudformation", "infra"], "repo": "*", "note": "" },
    { "task": "live AWS and Atlas state", "agent": "vivreal-ops:vivreal-ops", "keywords": ["aws", "atlas", "lambda", "cloudwatch"], "repo": "*", "note": "" },
    { "task": "Sentry", "agent": "vivreal-sentry:sentry", "keywords": ["sentry"], "repo": "*", "note": "" },
    { "task": "ads, GA4, marketing measurement, GTM", "agent": "vivreal-growth-analytics:growth", "keywords": ["ads", "ga4", "growth", "funnel", "gtm"], "repo": "*", "note": "numbers mode or GTM audit mode" },
    { "task": "product walks", "agent": "vivreal-product:qa-walker", "keywords": ["walk", "qa"], "repo": "*", "note": "before footage, never after" },
    { "task": "naive-owner passes", "agent": "vivreal-product:regular-user", "keywords": ["try"], "repo": "*", "note": "" },
    { "task": "built template versus exemplar, Studio gates", "agent": "vivreal-product:template-critic", "keywords": ["judge"], "repo": "*", "note": "" },
    { "task": "social draft critique", "agent": "vivreal-product:social-critic", "keywords": ["critique"], "repo": "*", "note": "" },
    { "task": "demo and QA tenant data setup", "agent": "vivreal-product:qa-walker", "keywords": ["seed", "setup"], "repo": "*", "note": "a setup step, writes through the app only; one-shot production scripts go to coder with ops-one-shot, small production fixes stay on the main thread" },
    { "task": "tutorials", "agent": "vivreal-content:tutorial-maker", "keywords": ["tutorial"], "repo": "vivreal-hq", "note": "" },
    { "task": "footage", "agent": "vivreal-content:footage-recorder", "keywords": ["record", "footage"], "repo": "vivreal-hq", "note": "" },
    { "task": "help pages; vivreal.io copy, showcase, screenshots", "agent": "vivreal-content:help-page-producer", "keywords": ["help-page", "help", "showcase", "screenshots"], "repo": "vivreal-hq", "note": "" },
    { "task": "carousels", "agent": "vivreal-content:carousel-editor", "keywords": ["carousel"], "repo": "vivreal-hq", "note": "" },
    { "task": "LinkedIn", "agent": "vivreal-content:linkedin-editor", "keywords": ["linkedin"], "repo": "vivreal-hq", "note": "" },
    { "task": "guides", "agent": "vivreal-content:guide-writer", "keywords": ["guide"], "repo": "vivreal-hq", "note": "" },
    { "task": "mascot", "agent": "vivreal-content:mascot-artist", "keywords": ["mascot", "pose"], "repo": "vivreal-hq", "note": "" },
    { "task": "business cards", "agent": "vivreal-content:business-card-maker", "keywords": ["card", "cards"], "repo": "vivreal-hq", "note": "" },
    { "task": "content planning", "agent": "vivreal-content:content-planner", "keywords": ["calendar", "content"], "repo": "vivreal-hq", "note": "" },
    { "task": "lead-gen fleet", "agent": "vivreal-leadgen:lead-pipeline", "keywords": ["leads", "leadgen", "prospect"], "repo": "vivreal-hq", "note": "" }
  ]
}
